# Local development uses SQLite by default.
# Production example (Supabase session pooler; keep the password secret):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/valuation.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Prices are fetched from Yahoo Finance's unofficial chart interface.
# Review the provider's terms before public/commercial deployment. Set false to disable.
ALLOW_UNOFFICIAL_PRICE_FEED=true

# Optional authorized feeds. The dashboard stays unavailable for these indicators until configured.
# CSV schema: date,value[,release_date][,is_estimate][,earnings_basis]
FORWARD_PE_CSV_URL=
FORWARD_PE_EARNINGS_BASIS=operating
FEAR_GREED_CSV_URL=

# auto uses forward P/E when a recent licensed series exists; otherwise a trailing proxy.
ERP_METHOD=auto

BREADTH_ENABLED=true
BREADTH_HISTORY_YEARS=6
BREADTH_MAX_TICKERS=503
BREADTH_MIN_CONSTITUENTS=400

SCORE_START_YEAR=1990
